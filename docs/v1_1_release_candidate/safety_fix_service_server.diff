+            WHEN json_extract(NEW.native,'$.eventType')='MOTOR_SHIPPED' AND NOT EXISTS
+                 (SELECT 1 FROM main.app_ship_tickets t WHERE t.motor=NEW.motor AND t.fingerprint=({self.FINGERPRINT_SQL}))
+            BEGIN SELECT RAISE(IGNORE); END""")
+        try:
