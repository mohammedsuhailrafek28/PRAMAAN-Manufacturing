{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Independent benchmark case, v1.2 (format only; no sealed case exists yet)",
 "type": "object",
 "required": [
  "caseId",
  "split",
  "story",
  "authorship",
  "registry",
  "recall",
  "motors"
 ],
 "properties": {
  "caseId": {
   "type": "string"
  },
  "split": {
   "enum": [
    "development",
    "sealed"
   ]
  },
  "story": {
   "type": "string",
   "description": "What physically happened; written without reference to candidate behaviour."
  },
  "authorship": {
   "type": "object",
   "required": [
    "author",
    "grounding"
   ],
   "properties": {
    "author": {
     "type": "string"
    },
    "grounding": {
     "enum": [
      "EXTERNAL_CITED",
      "INVENTED"
     ]
    },
    "citation": {
     "type": "string"
    },
    "reviewer": {
     "type": "string"
    },
    "reviewVerdict": {
     "enum": [
      "AGREE",
      "DISAGREE",
      "CONTESTED",
      "PENDING"
     ]
    }
   }
  },
  "registry": {
   "type": "object",
   "description": "Registry document in force when the first checkpoint was accepted (same shape as application/lot_registry.synthetic.json)",
   "required": [
    "entries"
   ]
  },
  "recall": {
   "type": "object",
   "required": [
    "lot"
   ],
   "properties": {
    "lot": {
     "type": "string"
    },
    "affectedSlots": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "enum": [
       "DE",
       "NDE"
      ]
     }
    }
   }
  },
  "steps": {
   "type": "array",
   "description": "Ordered timeline; each step happens after the previous one",
   "items": {
    "oneOf": [
     {
      "type": "object",
      "required": [
       "do",
       "motor",
       "lots"
      ],
      "properties": {
       "do": {
        "const": "assemble"
       },
       "motor": {
        "type": "string"
       },
       "route": {
        "enum": [
         "service",
         "bypass"
        ]
       },
       "lots": {
        "type": "object",
        "properties": {
         "DE": {
          "type": [
           "string",
           "null"
          ]
         },
         "NDE": {
          "type": [
           "string",
           "null"
          ]
         }
        }
       },
       "interruptAfterEvent": {
        "type": "integer"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "do",
       "motor",
       "slot",
       "lot"
      ],
      "properties": {
       "do": {
        "const": "replace"
       },
       "motor": {
        "type": "string"
       },
       "slot": {
        "enum": [
         "DE",
         "NDE"
        ]
       },
       "lot": {
        "type": [
         "string",
         "null"
        ]
       },
       "interruptAfterEvent": {
        "type": "integer"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "do",
       "motor",
       "slot",
       "label"
      ],
      "properties": {
       "do": {
        "const": "sighting"
       },
       "motor": {
        "type": "string"
       },
       "slot": {
        "enum": [
         "DE",
         "NDE"
        ]
       },
       "label": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     {
      "type": "object",
      "required": [
       "do"
      ],
      "properties": {
       "do": {
        "const": "ship"
       },
       "motor": {
        "type": "string"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "do"
      ],
      "properties": {
       "do": {
        "const": "announce_recall"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "do",
       "registry"
      ],
      "properties": {
       "do": {
        "const": "edit_registry"
       },
       "registry": {
        "type": "object",
        "description": "the full replacement registry document"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "do"
      ],
      "properties": {
       "do": {
        "const": "accept_checkpoint"
       },
       "acknowledgeRegistryChange": {
        "type": "boolean"
       },
       "acknowledgeMotors": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "acknowledgeAll": {
        "type": "boolean",
        "description": "The reviewing operator acknowledges every motor and the registry change the review asks about; rows whose identity cannot be established are refused regardless."
       },
       "expectAccepted": {
        "type": [
         "boolean",
         "null"
        ],
        "description": "Author expectation from the physical story: should the renewal be accepted at this step? Mark contested cases in the motor expectations."
       }
      }
     }
    ]
   }
  },
  "motors": {
   "type": "array",
   "description": "Expected outcome per motor after the LAST step",
   "items": {
    "type": "object",
    "required": [
     "motor",
     "expected"
    ],
    "properties": {
     "motor": {
      "type": "string"
     },
     "expected": {
      "type": "object",
      "required": [
       "mustHold"
      ],
      "properties": {
       "mustHold": {
        "type": "boolean"
       },
       "captureRefusedAtStep": {
        "type": [
         "integer",
         "null"
        ],
        "description": "0-based index of a step the application must refuse (no events written)"
       },
       "reasonClass": {
        "enum": [
         "LOT_IDENTITY",
         "REGISTRY_CHANGE",
         "OPERATION_INTERRUPTED",
         "UNVERIFIED_SIGHTING",
         "RECALL_EXPOSURE",
         "NONE"
        ]
       },
       "eligibleAfterAcceptedCheckpoint": {
        "type": "boolean"
       },
       "acceptShouldBeRefused": {
        "type": "boolean"
       },
       "contested": {
        "type": "boolean"
       },
       "rationale": {
        "type": "string"
       }
      }
     }
    }
   }
  }
 }
}